{
  "name": "query-drizzle",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/query-drizzle/src",
  "projectType": "library",
  "tags": [],
  "implicitDependencies": ["core"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/query-drizzle",
        "tsConfig": "packages/query-drizzle/tsconfig.lib.json",
        "packageJson": "packages/query-drizzle/package.json",
        "main": "packages/query-drizzle/src/index.ts",
        "assets": ["packages/query-drizzle/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/packages/query-drizzle"],
      "options": {
        "jestConfig": "packages/query-drizzle/jest.config.ts"
      }
    },
    "version": {
      "executor": "@jscutlery/semver:version",
      "options": {}
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm publish ./dist/packages/query-drizzle --access public"
      }
    }
  }
}
